# Copy to .env.local and fill in. NEVER commit real secrets.

# --- Encryption (required) ---
# 64 hex chars. Generate with:  openssl rand -hex 32
ENCRYPTION_KEY=

# --- Session signing (required for clinician logins) ---
# 32+ chars. Generate with:  openssl rand -hex 32
SESSION_SECRET=

# --- Database (production) ---
# Neon Postgres connection string. Leave blank in local dev to use the
# encrypted JSON-file fallback (data/submissions.local.json).
DATABASE_URL=

# --- SMTP email (TIFEC mailbox) ---
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=intake@tifec.org
SMTP_PASS=
SMTP_FROM=intake@tifec.org

# Public URL of the deployed app (used to build the secure link in emails).
APP_URL=http://localhost:3000

# --- Staff admin page ---
# Open /admin?key=THIS to see all submissions.
ADMIN_PASSWORD=
